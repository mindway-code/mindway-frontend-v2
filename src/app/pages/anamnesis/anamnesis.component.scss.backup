.anamnesis-page {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 28px 32px 48px;
  box-sizing: border-box;
  color: #172033;
}

/* =========================================================
   CABEÇALHO
   ========================================================= */

.anamnesis-page__hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;

  padding: 28px 32px;
  margin-bottom: 26px;

  background: #ffffff;
  border: 1px solid #e1e6eb;
  border-radius: 12px;
}

.anamnesis-page__hero-copy {
  min-width: 0;
}

.anamnesis-page__eyebrow {
  margin: 0 0 6px;

  font-size: 13px;
  font-weight: 600;
  color: #58708a;
}

.anamnesis-page__title {
  margin: 0;

  font-size: 30px;
  line-height: 1.2;
  font-weight: 700;
  color: #172033;
}

.anamnesis-page__subtitle {
  max-width: 760px;

  margin: 8px 0 0;

  font-size: 14px;
  line-height: 1.6;
  color: #718096;
}

.anamnesis-page__header-icon {
  flex: 0 0 auto;

  font-size: 27px;
  color: #607d9a;
}


/* =========================================================
   SELETOR DE CRIANÇA
   ========================================================= */

.anamnesis-page__child-selector {
  margin-bottom: 22px;
}

.anamnesis-page__selector-field {
  width: min(100%, 330px);
}

.anamnesis-page__selector-label {
  display: block;

  margin-bottom: 7px;

  font-size: 13px;
  font-weight: 600;
  color: #27364a;
}

.anamnesis-page__selector {
  width: 100%;
  min-height: 48px;

  padding: 0 40px 0 14px;

  border: 1px solid #d7dfe7;
  border-radius: 8px;

  background-color: #ffffff;
  color: #263548;

  font-size: 14px;

  outline: none;
  cursor: pointer;

  transition:
    border-color 0.15s ease,
    box-shadow 0.15s ease;
}

.anamnesis-page__selector:hover {
  border-color: #b9c7d5;
}

.anamnesis-page__selector:focus {
  border-color: #0d8f95;

  box-shadow:
    0 0 0 3px rgba(13, 143, 149, 0.1);
}

.anamnesis-page__selector:disabled {
  background: #f5f7f9;
  cursor: not-allowed;
}

.anamnesis-page__selector-count {
  margin: 7px 0 0;

  font-size: 13px;
  color: #788797;
}


/* =========================================================
   ESTADOS
   ========================================================= */

.anamnesis-page__error {
  margin-bottom: 20px;

  padding: 14px 16px;

  border: 1px solid #e5c7c7;
  border-radius: 8px;

  background: #fff8f8;

  color: #8d3d3d;
  font-size: 14px;
}

.anamnesis-page__loading {
  display: flex;
  flex-direction: column;
  gap: 10px;

  padding: 24px;

  background: #ffffff;
  border: 1px solid #e1e6eb;
  border-radius: 12px;
}

.anamnesis-page__loading span {
  display: block;

  height: 14px;

  border-radius: 6px;

  background: #edf1f4;
}

.anamnesis-page__loading span:first-child {
  width: 35%;
}

.anamnesis-page__loading span:nth-child(2) {
  width: 65%;
}

.anamnesis-page__loading span:last-child {
  width: 100%;
  height: 80px;
}


/* =========================================================
   ESTADO VAZIO
   ========================================================= */

.anamnesis-page__empty {
  padding: 26px 28px;

  margin-bottom: 24px;

  background: #ffffff;

  border: 1px solid #dfe5ea;
  border-radius: 10px;
}

.anamnesis-page__empty h2 {
  margin: 0 0 7px;

  font-size: 17px;
  font-weight: 650;

  color: #087c82;
}

.anamnesis-page__empty p {
  margin: 0;

  font-size: 14px;
  line-height: 1.55;

  color: #758497;
}

.anamnesis-page__primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  min-height: 42px;

  padding: 0 17px;

  border: 0;
  border-radius: 7px;

  background: #0b9096;
  color: #ffffff;

  font-size: 13px;
  font-weight: 600;

  cursor: pointer;

  transition:
    background 0.15s ease,
    transform 0.15s ease;
}

.anamnesis-page__primary-button:hover {
  background: #087c82;
}

.anamnesis-page__primary-button:active {
  transform: translateY(1px);
}

.anamnesis-page__primary-button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}


/* =========================================================
   RESUMO DA CRIANÇA
   ========================================================= */

.anamnesis-page__child-summary {
  display: grid;

  grid-template-columns:
    auto
    minmax(130px, 180px)
    minmax(240px, 1fr)
    auto;

  align-items: center;

  gap: 18px;

  padding: 18px 20px;

  margin-bottom: 22px;

  background: #ffffff;

  border: 1px solid #dfe5ea;
  border-radius: 11px;
}

.anamnesis-page__child-avatar {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 48px;
  height: 48px;

  border-radius: 50%;

  background: #f0f4f7;
  color: #425a73;

  font-size: 17px;
  font-weight: 700;
}

.anamnesis-page__child-info {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.anamnesis-page__child-info strong {
  font-size: 15px;
  color: #172033;
}

.anamnesis-page__child-info span {
  font-size: 13px;
  color: #77879a;
}


/* =========================================================
   PROGRESSO
   ========================================================= */

.anamnesis-page__progress {
  min-width: 0;
}

.anamnesis-page__progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 6px;

  font-size: 12px;
  color: #63758a;
}

.anamnesis-page__progress-header strong {
  color: #172033;
  font-size: 13px;
}

.anamnesis-page__progress-track {
  width: 100%;
  height: 7px;

  overflow: hidden;

  border-radius: 99px;

  background: #e6ebf0;
}

.anamnesis-page__progress-value {
  height: 100%;

  border-radius: inherit;

  background: #0b9096;

  transition: width 0.25s ease;
}

.anamnesis-page__progress small {
  display: block;

  margin-top: 5px;

  font-size: 11px;
  color: #8492a2;
}

.anamnesis-page__status {
  white-space: nowrap;

  padding: 7px 10px;

  border: 1px solid #dce5eb;
  border-radius: 6px;

  background: #f8fafb;

  color: #53677c;

  font-size: 11px;
  font-weight: 600;
}


/* =========================================================
   CONTINUAR
   ========================================================= */

.anamnesis-page__continue {
  display: grid;

  grid-template-columns: auto 1fr auto;

  align-items: center;

  gap: 15px;

  padding: 17px 18px;

  margin-bottom: 26px;

  border: 1px solid #d7e2e6;
  border-radius: 10px;

  background: #f8fbfb;
}

.anamnesis-page__continue-icon {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 42px;
  height: 42px;

  border-radius: 8px;

  background: #e9f6f6;
  color: #0b9096;

  font-size: 20px;
}

.anamnesis-page__continue-content {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.anamnesis-page__continue-content > span {
  font-size: 10px;
  font-weight: 700;

  letter-spacing: 0.04em;

  color: #0b858b;
}

.anamnesis-page__continue-content strong {
  font-size: 14px;
  color: #172033;
}

.anamnesis-page__continue-content p {
  margin: 1px 0 0;

  font-size: 12px;
  line-height: 1.4;

  color: #77879a;
}


/* =========================================================
   TÍTULO DAS SEÇÕES
   ========================================================= */

.anamnesis-page__section-header {
  margin-bottom: 13px;
}

.anamnesis-page__section-header h2 {
  margin: 0;

  font-size: 20px;
  line-height: 1.3;

  color: #172033;
}

.anamnesis-page__section-header p {
  margin: 5px 0 0;

  font-size: 13px;
  color: #788798;
}


/* =========================================================
   LISTA DAS SEÇÕES
   ========================================================= */

.anamnesis-page__sections {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.anamnesis-page__section-item {
  display: grid;

  grid-template-columns:
    32px
    44px
    minmax(0, 1fr)
    auto
    18px;

  align-items: center;

  gap: 12px;

  width: 100%;

  padding: 14px 16px;

  text-align: left;

  border: 1px solid #dfe5ea;
  border-radius: 10px;

  background: #ffffff;

  color: inherit;

  cursor: pointer;

  transition:
    border-color 0.15s ease,
    background 0.15s ease,
    transform 0.15s ease;
}

.anamnesis-page__section-item:hover {
  border-color: #b8cbd3;
  background: #fbfcfd;

  transform: translateY(-1px);
}

.anamnesis-page__section-number {
  font-size: 11px;
  font-weight: 600;

  color: #8291a1;

  text-align: center;
}

.anamnesis-page__section-icon {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 42px;
  height: 42px;

  border-radius: 8px;

  background: #f1f5f8;

  color: #59728a;

  font-size: 17px;
}

.anamnesis-page__section-content {
  display: flex;
  flex-direction: column;
  gap: 3px;

  min-width: 0;
}

.anamnesis-page__section-content strong {
  font-size: 14px;
  font-weight: 650;

  color: #172033;
}

.anamnesis-page__section-content small {
  font-size: 12px;
  line-height: 1.4;

  color: #7a8999;
}

.anamnesis-page__section-status {
  white-space: nowrap;

  padding: 6px 9px;

  border: 1px solid #dce4ea;
  border-radius: 5px;

  background: #f8fafb;

  color: #6c7d8e;

  font-size: 10px;
  font-weight: 600;
}

.anamnesis-page__section-status--done {
  border-color: #bde7d0;

  background: #f2fbf6;

  color: #23804d;
}

.anamnesis-page__section-item > .bi-chevron-right {
  color: #9aa7b4;
  font-size: 13px;
}


/* =========================================================
   VOLTAR
   ========================================================= */

.anamnesis-page__back {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  padding: 0;

  margin: 0 0 14px;

  border: 0;

  background: transparent;

  color: #526b82;

  font-size: 13px;

  cursor: pointer;
}

.anamnesis-page__back:hover {
  color: #0b858b;
}


/* =========================================================
   AJUDA
   ========================================================= */

.anamnesis-page__help {
  display: flex;
  align-items: flex-start;
  gap: 12px;

  padding: 13px 15px;

  margin-bottom: 16px;

  border: 1px solid #dbe4ea;
  border-radius: 8px;

  background: #f8fafc;
}

.anamnesis-page__help > i {
  flex: 0 0 auto;

  margin-top: 1px;

  color: #58738d;
  font-size: 16px;
}

.anamnesis-page__help strong {
  display: block;

  margin-bottom: 2px;

  font-size: 12px;
  color: #26384b;
}

.anamnesis-page__help p {
  margin: 0;

  font-size: 12px;
  line-height: 1.5;

  color: #748497;
}


/* =========================================================
   RESPONSIVO
   ========================================================= */

@media (max-width: 850px) {
  .anamnesis-page {
    padding: 20px;
  }

  .anamnesis-page__child-summary {
    grid-template-columns:
      auto
      1fr
      auto;
  }

  .anamnesis-page__progress {
    grid-column: 1 / -1;
  }

  .anamnesis-page__status {
    justify-self: end;
  }
}

@media (max-width: 650px) {
  .anamnesis-page {
    padding: 16px;
  }

  .anamnesis-page__hero {
    padding: 22px;
  }

  .anamnesis-page__title {
    font-size: 26px;
  }

  .anamnesis-page__header-icon {
    display: none;
  }

  .anamnesis-page__child-summary {
    grid-template-columns: auto 1fr;
  }

  .anamnesis-page__status {
    grid-column: 2;
    justify-self: start;
  }

  .anamnesis-page__progress {
    grid-column: 1 / -1;
  }

  .anamnesis-page__continue {
    grid-template-columns: auto 1fr;
  }

  .anamnesis-page__continue
    .anamnesis-page__primary-button {
    grid-column: 1 / -1;
    width: 100%;
  }

  .anamnesis-page__section-item {
    grid-template-columns:
      28px
      40px
      minmax(0, 1fr)
      16px;

    gap: 9px;

    padding: 12px;
  }

  .anamnesis-page__section-status {
    display: none;
  }

  .anamnesis-page__section-icon {
    width: 38px;
    height: 38px;
  }
}